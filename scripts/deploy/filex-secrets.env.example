# 复制到生产持久化目录（Bamboo 不会删除），例如：
#   /root/docker/important/FileX/secrets/filex.env
# chmod 600 后填入真实值。勿提交 Git。

FILEX_LICENSE_HMAC_SECRET=

# 105 extract-asset signed URL（多实例须一致；未设则 fallback FILEX_SECRET_KEY）
FILEX_ASSET_SIGNING_SECRET=

# 135 RAGAS 在线评估（默认关闭；设 true 开启，复用 KB 后处理 LLM 配置）
# 仅 filex 容器读取；本地开发见 docker/docker-compose.local.yml。
KB_RAGAS_ONLINE_EVAL_ENABLED=false
# 采样率 0.0-1.0，1.0=每条 RAG 回答都评估
KB_RAGAS_ONLINE_EVAL_SAMPLE_RATE=1.0
# RAGAS LLM 评测超时秒数
KB_RAGAS_ONLINE_EVAL_TIMEOUT_SECONDS=600
