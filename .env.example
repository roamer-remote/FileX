# FileX Docker distribution configuration.
# Copy to .env before starting:
#   cp .env.example .env

FILEX_VERSION=latest
FILEX_ENV=development

# Container images. Public users must be able to pull these images, or run
# `docker login ghcr.io` before `docker compose pull`.
FILEX_APP_IMAGE=ghcr.io/roamer-remote/filex-app:${FILEX_VERSION}
FILEX_EXTRACT_IMAGE=ghcr.io/roamer-remote/filex-kb-extract:${FILEX_VERSION}
FILEX_MINERU_IMAGE=ghcr.io/roamer-remote/filex-mineru:${FILEX_VERSION}
FILEX_POSTGRES_IMAGE=ghcr.io/roamer-remote/filex-postgres:pg16-zh
FILEX_RERANK_IMAGE=ghcr.io/roamer-remote/filex-rerank:cpu-1.5

# Bind mount root for persistent data. Keep it outside the repository if the
# installation will be upgraded by git pull.
FILEX_DATA_ROOT=./data

# Web access. Keep 127.0.0.1 for local-only use; change to 0.0.0.0 on a server
# behind a firewall or reverse proxy.
FILEX_HOST=127.0.0.1
FILEX_PORT=8000
FILEX_ORIGIN=http://127.0.0.1:8000

# Initial admin user. Used only when the database is first initialized.
FILEX_BOOTSTRAP_USERNAME=admin
FILEX_BOOTSTRAP_PASSWORD=change-me-before-first-start

# Replace both secrets before production use. scripts/install.sh can generate
# local values automatically.
FILEX_SECRET_KEY=change-me-filex-secret
FILEX_ASSET_SIGNING_SECRET=change-me-asset-signing-secret
FILEX_LICENSE_HMAC_SECRET=

# Internal database and queue credentials. Change before first start.
POSTGRES_USER=filebox
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=filebox
RABBITMQ_DEFAULT_USER=filebox
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password

# Local model runtime.
OLLAMA_EMBED_MODEL=bge-m3:latest
OLLAMA_CHAT_MODEL=qwen3.5:cloud
OLLAMA_PULL_MODELS=bge-m3:latest
OLLAMA_NUM_PARALLEL=4
OLLAMA_EMBED_DIM=1024
OLLAMA_EMBED_BATCH_SIZE=48
OLLAMA_EMBED_CONCURRENCY=4

# Worker sizing for a single-machine CPU install.
KB_INDEX_CONCURRENCY=4
KB_EXTRACT_CONCURRENCY=1
KB_POST_CONCURRENCY=1
