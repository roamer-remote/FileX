# 复制为 .env 后按需修改（docker compose / 本地开发均可引用）

FILEBOX_SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql://filebox:filebox@127.0.0.1:5432/filebox
UPLOAD_DIR=./backend/uploads
FILEBOX_ENV=development
FILEBOX_BOOTSTRAP_USERNAME=admin
FILEBOX_BOOTSTRAP_PASSWORD=change-me
# Ollama（069）：仅 filex-ollama 容器；11434 不映射宿主机
# Compose 容器（filex / kb-indexer）：OLLAMA_BASE_URL=http://filex-ollama:11434（11434 不映射宿主机）
# 本地 ./start.sh：filex API 在容器内；kb-extract 在宿主机
# OLLAMA_BASE_URL=http://filex-ollama:11434
# nomic-embed-text → OLLAMA_EMBED_DIM=768；bge-m3:latest → 1024
OLLAMA_EMBED_MODEL=bge-m3:latest
OLLAMA_EMBED_DIM=1024

# 语义检索 Cross-Encoder 重排序（TEI /rerank）；本地 ./start.sh 默认 http://127.0.0.1:8081/rerank
KB_RERANK_URL=http://127.0.0.1:8081/rerank
# TEI rerank 单次请求 passages 上限（默认 32，与 kb-rerank 容器一致）
KB_RERANK_MAX_BATCH_SIZE=32
# kb-rerank 容器拉取 BAAI/bge-reranker-base 到 rerank_data/model/（TEI 本地 --model-id /data/model）
# 向量相似度下限，0 关闭过滤
KB_SEARCH_MIN_SCORE=0.35
KB_SEARCH_BOOST_KEYWORD_BONUS=0.12
KB_SEARCH_MMR_LAMBDA=0.7

# 微信开放平台「网站应用」扫码登录与绑定（三者齐备才启用；留空则 Web 走开发 mock）
# FILEX_WECHAT_APP_ID=
# FILEX_WECHAT_APP_SECRET=
# FILEX_WECHAT_REDIRECT_URI=https://your-domain/api/wechat/callback
# FILEX_WECHAT_STATE_TTL_MINUTES=15

# 021 系统 License：HMAC 验签/签发密钥（生产必填；勿提交 Git）
# 本地开发可留空（FILEX_ENV=development 有 dev 默认）。
# 生产 Bamboo：勿放 CI 检出目录 .env；见 scripts/deploy/filex-secrets.env.example
#   → /root/important/FileX/product/secrets/filex.env + docker-compose.prod.yml
# FILEX_LICENSE_HMAC_SECRET=
